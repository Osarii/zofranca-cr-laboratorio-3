# Cree una clave gratuita en https://aistudio.google.com/apikey
# Nunca use el prefijo VITE_: la clave debe permanecer en el servidor.
GEMINI_API_KEY="pegue_aqui_su_clave"

# Gemini 3.6 Flash es estable y admite el nivel gratuito.
# Puede usar gemini-3.5-flash, pero Google lo clasifica como heredado.
GEMINI_MODEL="gemini-3.6-flash"

# Si el modelo principal no está habilitado, el servidor prueba estos modelos.
GEMINI_FALLBACK_MODELS="gemini-3.5-flash,gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
