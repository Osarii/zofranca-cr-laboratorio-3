{
  "name": "zofranca-cr-laboratorio-3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n DATA,AI,WEB -c cyan,yellow,blue \"npm:dev:api\" \"npm:dev:ai\" \"npm:dev:web\"",
    "dev:api": "json-server db.json --port 3001",
    "dev:ai": "node --import tsx server/aiServer.ts",
    "dev:web": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/clasificador.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@number-flow/react": "^0.6.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "howler": "^2.2.4",
    "json-server": "0.17.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
